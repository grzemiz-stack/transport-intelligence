# =============================================================================
# Transport Intelligence — environment variables
# Copy to .env and fill in required values before starting.
# =============================================================================

# --- PostgreSQL (REQUIRED) ---------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=transport_intel
POSTGRES_USER=admin
POSTGRES_PASSWORD=
DATABASE_URL=postgresql+asyncpg://admin:PASSWORD@localhost:5432/transport_intel

# --- Neo4j (REQUIRED) -------------------------------------------------------
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# --- Kafka -------------------------------------------------------------------
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# --- Redis -------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# --- API ---------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=false

# --- JWT Auth (REQUIRED) ----------------------------------------------------
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# --- NLP / AI ----------------------------------------------------------------
SPACY_MODEL=xx_ent_wiki_sm
TRANSFORMERS_MODEL=xlm-roberta-base

# --- SMTP (email notifications) ----------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=alerts@transport-intel.com
SMTP_ENABLED=false
DASHBOARD_URL=http://localhost:3000

# --- Anthropic (translation) -------------------------------------------------
ANTHROPIC_API_KEY=
TRANSLATION_ENABLED=false

# --- Companies House (UK) API ------------------------------------------------
COMPANIES_HOUSE_API_KEY=

# --- Telegram (Telethon) — get from https://my.telegram.org/apps -------------
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_PHONE=
TELEGRAM_SESSION_NAME=ti_session

# --- Discord -----------------------------------------------------------------
DISCORD_BOT_TOKEN=
